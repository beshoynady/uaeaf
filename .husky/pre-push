# Pre-push gate: the API compiles, and api/openapi.json is exactly the document
# that compiled API produces. What this hook checks, what CI checks, and when
# --no-verify is acceptable: docs/engineering/quality-gates.md.
#
# It compiles into api/dist-openapi/ through tsconfig.openapi.json, never into
# api/dist/, so it stays incremental and leaves a running `start:dev` alone.

# The check runs on the working tree. Uncommitted API changes are compiled too,
# and they can move openapi.json when the commits being pushed do not.
if [ -n "$(git status --porcelain -- api/src)" ]; then
  echo "[pre-push] تنبيه: في api/src تعديلات لم تُلتزَم، والفحص يشملها. الـ CI يفحص الـ commit نفسه."
  echo "[pre-push] Note: api/src has uncommitted changes, and this check includes them. CI checks the pushed commit itself."
fi

echo "[pre-push] Compiling the API..."
if ! npm --prefix api run --silent build:openapi; then
  echo ""
  echo "[pre-push] الـ API لا يُترجَم: أصلح أخطاء TypeScript أعلاه، ثم أعد الـ push."
  echo "[pre-push] The API does not compile: fix the TypeScript errors above, then push again."
  exit 1
fi

echo "[pre-push] Regenerating api/openapi.json..."
# The generator boots the whole app, and Mongoose keeps retrying an unreachable
# MONGODB_URI instead of failing, so the run gets a time limit. execFile starts
# node itself with no shell in between, so the limit stops the generator rather
# than a shell that would leave it running.
node -e "
const { execFile } = require('child_process');
const child = execFile(process.execPath, ['dist-openapi/generate-openapi.js'], { cwd: 'api', timeout: 60000 });
child.stdout.pipe(process.stdout);
child.stderr.pipe(process.stderr);
child.on('exit', (code, signal) => {
  if (signal) {
    console.error('\n[pre-push] توليد openapi.json تجاوز 60 ثانية: غالبًا MONGODB_URI في api/.env غير متاح. شغّل MongoDB ثم أعد الـ push.');
    console.error('[pre-push] Generating openapi.json took over 60s: MONGODB_URI in api/.env is most likely unreachable. Start MongoDB, then push again.\n');
    process.exitCode = 1;
  } else {
    process.exitCode = code ?? 1;
  }
});
" || exit 1

if ! git diff --quiet HEAD -- api/openapi.json; then
  echo ""
  echo "[pre-push] api/openapi.json تغيّر عن آخر commit: راجع الفرق واعمل له commit، ثم أعد الـ push."
  echo "[pre-push] api/openapi.json differs from the last commit: review the diff and commit it, then push again."
  echo ""
  exit 1
fi

echo "[pre-push] api/openapi.json is in sync."
