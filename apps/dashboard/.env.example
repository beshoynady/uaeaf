# Where this dashboard's BFF route handlers forward to. Server-side only —
# deliberately NOT prefixed with NEXT_PUBLIC_, because the browser never talks
# to the NestJS API directly (owner decision D1, 2026-09-07: BFF over CORS).
UAEAF_API_URL=http://localhost:3000

# Single sign-on providers offered on the login screen, comma separated.
# Recognised values: google, microsoft.
#
# Left EMPTY on purpose. The user schema's AUTH_PROVIDERS lists Google and
# Microsoft, but the API exposes no OAuth endpoint yet — so the buttons stay
# hidden rather than leading nowhere. Set this only once
# GET /auth/sso/:provider exists upstream.
UAEAF_SSO_PROVIDERS=
