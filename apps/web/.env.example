# The NestJS API the site reads its content from, and that the contact form's
# route handler posts to. Server-side only — deliberately NOT prefixed with
# NEXT_PUBLIC_: the browser never talks to the API directly. Left unset, it
# falls back to http://localhost:3000.
UAEAF_API_URL=http://localhost:3000

# The site's own public origin, with no trailing slash. Every canonical and
# hreflang link, the sitemaps, robots.txt and the structured data are built from
# it. NEXT_PUBLIC_, so it is fixed into the build: set it before building.
#
# Left unset, it falls back to http://localhost:3001 — in production that would
# publish localhost as every page's canonical address and in the sitemap. It is
# a go-live item in docs/engineering/deployment-checklist.md.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3001

# Kinds of motion to switch off without a build, comma separated.
# Recognised values: press, hero, seam, rise, route — or all.
# Left EMPTY, everything moves. Read on each render (the layout revalidates), so
# a change takes effect after the server restarts.
UAEAF_MOTION_OFF=
