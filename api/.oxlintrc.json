{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "func-style": [
      "warn",
      "expression"
    ],
    "prefer-arrow-callback": "warn"
  },
  "env": {
    "builtin": true
  }
}
