NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/uaeaf?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-real-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Image store. Optional at startup; uploads fail without them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The first administrator, created by `npm run bootstrap:admin` and `npm run seed:dev`.
# Password: 12 characters or more. An account that already exists is never changed.
BOOTSTRAP_ADMIN_EMAIL=admin@uaeaf.ae
BOOTSTRAP_ADMIN_PASSWORD=admin1234567
# BOOTSTRAP_ADMIN_NAME_EN=Platform Administrator
# BOOTSTRAP_ADMIN_NAME_AR=مسؤول المنصة

# The password of the newsroom demo accounts, created by `npm run seed:newsroom`.
# Development databases only: the script refuses any other target, and it stops
# with an error when this is empty.
DEV_ADMIN_PASSWORD=
